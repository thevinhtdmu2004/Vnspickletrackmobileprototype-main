# Stage 1: Cài đặt dependency và build mã nguồn React/Vite
FROM node:20-alpine AS build
WORKDIR /app

# Copy package.json và package-lock.json từ thư mục frontend
COPY package.json package-lock.json ./
RUN npm ci

# Copy toàn bộ mã nguồn frontend và tiến hành build ra thư mục dist
COPY . .
RUN npm run build

# Stage 2: Sử dụng Nginx để phục vụ file tĩnh đã build
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
